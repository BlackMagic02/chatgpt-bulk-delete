{
  "manifest_version": 3,
  "name": "ChatGPT Bulk Delete",
  "version": "0.0.1",
  "description": "Filter, review and delete selected ChatGPT conversations.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "ChatGPT Bulk Delete"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "date-cache.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "date-reader.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
